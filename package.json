{
  "name": "orca-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Orca–Pi orchestration: thin Orca plugin + companion orca-pi CLI (OP1.1 scaffold)",
  "type": "commonjs",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "doctor": "node packages/cli/dist/main.js doctor",
    "clean": "tsc -b --clean",
    "check:skill-size": "node scripts/check-skill-size.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=18"
  }
}
