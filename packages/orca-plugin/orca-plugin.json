{
  "manifestVersion": 1,
  "id": "orca-pi",
  "publisher": "44madfire",
  "name": "Orca–Pi Orchestration",
  "version": "0.1.0",
  "description": "Orca–Pi Control Center bridge: versioned panel↔bridge protocol over authoritative profile/config services. Live data via structured requests; degraded CLI fallback with explicit terminal actions when the host lacks bridge support.",
  "repository": "https://github.com/44madfire/orca-pi",
  "engines": {
    "orca": ">=1.4.0"
  },
  "pluginApi": 1,
  "main": "worker-entry.mjs",
  "contributes": {
    "panels": [
      {
        "id": "orca-pi-status",
        "title": "Orca-Pi Status",
        "entry": "panel.html"
      },
      {
        "id": "orca-pi-profiles",
        "title": "Orca-Pi Profiles",
        "entry": "panel/profiles.html"
      }
    ],
    "commands": []
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "terminal:send"
    }
  ]
}
