{
  "manifestVersion": 1,
  "id": "orca-pi",
  "publisher": "44madfire",
  "name": "Orca–Pi Orchestration",
  "version": "0.1.0",
  "description": "Thin Orca UI shell over the companion orca-pi CLI. Status panel plus read-only Pi profiles sidebar (CLI authoritative).",
  "repository": "https://github.com/44madfire/orca-pi",
  "engines": {
    "orca": ">=1.4.0"
  },
  "pluginApi": 1,
  "contributes": {
    "panels": [
      {
        "id": "orca-pi-status",
        "title": "Orca-Pi Status",
        "entry": "panel.html"
      },
      {
        "id": "orca-pi-profiles",
        "title": "Orca-Pi Profiles",
        "entry": "panel/profiles.html"
      }
    ],
    "commands": []
  },
  "capabilities": []
}
