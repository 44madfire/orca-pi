# Enforce LF for prompt/profile text files so builtin prompt sync tests
# stay byte-identical across Windows/macOS/Linux checkouts.
prompts/*.md text eol=lf
profiles/*.yaml text eol=lf
packages/core/test/fixtures/profiles/* text eol=lf
packages/orca-plugin/skills/**/SKILL.md text eol=lf
scripts/*.mjs text eol=lf
packages/pi-rpc/fixtures/*.jsonl text eol=lf
packages/pi-rpc/fixtures/*.json text eol=lf
packages/pi-rpc/docs/*.md text eol=lf
